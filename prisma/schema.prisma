generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  Active
  Blocked
}

enum AdvertisementStatus {
  Open
  Closed
  Blocked
}

enum RoleName {
  Admin
  Advertiser
  Guest
}

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Address {
  id             Int             @id @default(autoincrement())
  stateCode      String          @default("CE")
  stateName      String          @default("Ceará")
  cityName       String          @default("Cedro")
  neighborhood   String
  postalCode     String          @default("00000-000")
  street         String?
  number         String?
  complement     String?
  users          User[]
  advertisements Advertisement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  phone          String
  instagram      String?
  avatarUrl      String?
  avatarBlobId   Int?
  avatarBlob     ImageBlob?      @relation("UserAvatarBlob", fields: [avatarBlobId], references: [id], onDelete: SetNull)
  address        Address         @relation(fields: [addressId], references: [id])
  addressId      Int
  status         UserStatus      @default(Active)
  role           Role?           @relation(fields: [roleId], references: [id])
  roleId         Int?
  advertisements Advertisement[] @relation("AdvertisementToUser")
  reviews        Review[]
  complaints     Complaint[]
  favorites      Advertisement[] @relation(name: "FavoriteToUser")
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([roleId])
  @@index([avatarBlobId])
}

model Advertisement {
  id           Int                    @id @default(autoincrement())
  advertiser   User                   @relation(name: "AdvertisementToUser", fields: [advertiserId], references: [id])
  advertiserId Int
  pictures     AdvertisementPicture[]
  title        String
  description  String
  price        Int // In cents
  conditions   String
  category     Category               @relation(fields: [categoryId], references: [id])
  categoryId   Int
  address      Address?               @relation(fields: [addressId], references: [id])
  addressId    Int?
  status       AdvertisementStatus    @default(Open)
  reviews      Review[]
  complaints   Complaint[]
  favoritedBy  User[]                 @relation(name: "FavoriteToUser")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([advertiserId])
  @@index([categoryId])
  @@index([status])
}

model AdvertisementPicture {
  id              Int           @id @default(autoincrement())
  url             String
  blobId          Int?
  blob            ImageBlob?    @relation(fields: [blobId], references: [id], onDelete: SetNull)
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([blobId])
}

model ImageBlob {
  id                    Int                    @id @default(autoincrement())
  data                  Bytes
  mimeType              String
  fileName              String?
  sizeBytes             Int
  userAvatarReferences  User[]                 @relation("UserAvatarBlob")
  advertisementPictures AdvertisementPicture[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  advertisements Advertisement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
}

model Review {
  id              Int           @id @default(autoincrement())
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementId Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  rating          Int
  comment         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Complaint {
  id              Int           @id @default(autoincrement())
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementId Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  reason          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String
  body      String
  read      Boolean   @default(false)
  sentAt    DateTime  @default(now())
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  tokenHash String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([expiresAt])
}
