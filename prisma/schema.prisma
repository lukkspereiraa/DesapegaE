// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_backend {
  provider = "prisma-client"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model City {
  id Int @id @default(autoincrement())
  name String
  postalCode String
  state State @relation(fields: [stateId], references: [id])
  stateId Int

  addresses Address[]
}

model State {
  id Int @id @default(autoincrement())
  name String
  code String
  cities City[]
}

model Address {
  id Int @id @default(autoincrement())
  city City @relation(fields: [cityId], references: [id])
  cityId Int
  neighborhood String

  users User[]
}

enum UserStatus {
  Active
  Blocked
}

enum UserKind {
  Common
  Admin
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String
  password String
  phone String
  avatarUrl String
  address Address @relation(fields: [addressId], references: [id])
  addressId Int
  status UserStatus @default(Active)
  kind UserKind @default(Common)
  advertisements Advertisement[] @relation("AdvertisementToUser")
  reviews Review[]
  complaints Complaint[]
  favorites Advertisement[] @relation(name: "FavoriteToUser")
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdvertisementStatus {
  Open
  Closed
  Blocked
}

model Advertisement {
  id Int @id @default(autoincrement())
  advertiser User @relation(name: "AdvertisementToUser", fields: [advertiserId], references: [id])
  advertiserId Int
  pictures AdvertisementPicture[]
  title String
  description String
  price Int // In cents
  conditions String
  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  status AdvertisementStatus @default(Open)
  reviews Review[]
  complaints Complaint[]
  favoritedBy User[] @relation(name: "FavoriteToUser")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdvertisementPicture {
  id Int @id @default(autoincrement())
  url String
  advertisement Advertisement @relation(fields: [advertisementId], references: [id])
  advertisementId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  
}

model Category {
  id Int @id @default(autoincrement())
  name String
  advertisements Advertisement[]
}

model Review {
  id Int @id @default(autoincrement())
  advertisement Advertisement @relation(fields: [advertisementId], references: [id])
  advertisementId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  rating Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id Int @id @default(autoincrement())
  advertisement Advertisement @relation(fields: [advertisementId], references: [id])
  advertisementId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  reason String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int
  title String
  body String
  read Boolean @default(false)

  sentAt DateTime @default(now())
  readAt DateTime
}